{
  "name": "pi-mermaid",
  "version": "0.0.0",
  "description": "Render Mermaid diagrams inline in the pi TUI with the Pele engine.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mermaid",
    "pele"
  ],
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duylvh/pi-mermaid.git"
  }
}
